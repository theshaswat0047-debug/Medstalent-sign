// Vaultsign — Enterprise E-Signature Platform Schema
// Multi-tenant: Superadmin → Organizations → Departments → Teams → Users

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// PLATFORM LEVEL (Superadmin scope)
// ============================================================

model PlatformAdmin {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          PlatformAdminRole @default(SUPERADMIN)
  twoFactorSecret String?
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum PlatformAdminRole {
  SUPERADMIN
  SUPPORT
  BILLING
  ENGINEER
}

model PlatformSettings {
  id              String   @id @default(cuid())
  brevoApiKey     String?  // Brevo transactional email API key
  brevoSenderId   String?  // Brevo approved sender ID
  brevoWebhookUrl String?  // Brevo webhook endpoint for delivery events
  stripeSecretKey String?
  defaultFromEmail String?
  defaultFromName String?
  maintenanceMode Boolean  @default(false)
  signupEnabled   Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SubscriptionPlan {
  id              String   @id @default(cuid())
  name            String   // Starter / Business / Enterprise
  monthlyPrice    Float
  yearlyPrice     Float
  envelopesPerMonth Int    // -1 = unlimited
  storageGb       Int
  apiCallsPerDay  Int
  usersIncluded   Int
  ssoEnabled      Boolean  @default(false)
  whiteLabel      Boolean  @default(false)
  customBranding  Boolean  @default(false)
  active          Boolean  @default(true)
  organizations   Organization[]
  createdAt       DateTime @default(now())
}

// ============================================================
// ORGANIZATION LEVEL (Tenant)
// ============================================================

model Organization {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  logoUrl         String?
  primaryColor    String?  @default("#1A1A1A")
  customDomain    String?
  brandEmailTemplate String?
  planId          String?
  plan            SubscriptionPlan? @relation(fields: [planId], references: [id])
  status          OrgStatus @default(ACTIVE)
  trialEndsAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  departments     Department[]
  users           User[]
  documents       Document[]
  templates       Template[]
  apiKeys         ApiKey[]
  auditLogs       AuditLog[]
  auditEntries    AuditEntry[]
  integrations    Integration[]
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  EXPIRED
}

model Department {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  parentId        String?  // for nested departments
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  teams           Team[]
  users           User[]
}

model Team {
  id              String   @id @default(cuid())
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name            String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
}

// ============================================================
// USERS & AUTH
// ============================================================

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  passwordHash    String?
  avatarUrl       String?
  role            UserRole @default(USER)
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  teamId          String?
  team            Team? @relation(fields: [teamId], references: [id])
  jobTitle        String?
  phone           String?
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret String?
  status          UserStatus @default(ACTIVE)
  lastLoginAt     DateTime?
  invitedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  documentsOwned  Document[]      @relation("DocumentsOwned")
  recipients      Recipient[]
  signatures      Signature[]
  auditLogs       AuditLog[]
  auditEntries    AuditEntry[]
  notifications   Notification[]
}

enum UserRole {
  SUPERADMIN
  ORG_ADMIN
  MANAGER
  USER
  VIEWER
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
  DELETED
}

// ============================================================
// TEMPLATES LIBRARY (100+)
// ============================================================

model TemplateCategory {
  id              String   @id @default(cuid())
  name            String   @unique   // HR, Legal, Real Estate, Sales, Finance, Healthcare, Education, Government
  icon            String?
  description     String?
  sortOrder       Int      @default(0)
  templates       Template[]
  createdAt       DateTime @default(now())
}

model Template {
  id              String   @id @default(cuid())
  name            String
  description     String?
  categoryId      String?
  category        TemplateCategory? @relation(fields: [categoryId], references: [id])
  organizationId  String?  // null = global/shared template
  organization    Organization? @relation(fields: [organizationId], references: [id])
  thumbnailUrl    String?
  fileUrl         String    // source PDF/DOCX
  pageCount       Int       @default(1)
  fields          String    // JSON: signature field placements
  mergeFields     String?   // JSON: list of merge field definitions
  tags            String?  // comma separated
  isPublic        Boolean   @default(true)
  usageCount      Int       @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  documents       Document[]
}

// ============================================================
// DOCUMENTS & ENVELOPES
// ============================================================

model Document {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  ownerId         String
  owner           User     @relation("DocumentsOwned", fields: [ownerId], references: [id])
  templateId      String?
  template        Template? @relation(fields: [templateId], references: [id])
  name            String
  description     String?
  fileUrl         String
  pageCount       Int      @default(1)
  fileSize        Int      @default(0)
  fields          String   // JSON: field placements + values
  status          DocumentStatus @default(DRAFT)
  signingOrder    String  @default("SEQUENTIAL")  // SEQUENTIAL | PARALLEL
  expiresAt       DateTime?
  reminderDays    Int      @default(3)
  authMethod      String  @default("EMAIL")  // EMAIL | SMS | KBA | ID
  watermarkEnabled Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  recipients      Recipient[]
  signatures      Signature[]
  events          DocumentEvent[]
  auditTrail      AuditEntry[]
}

enum DocumentStatus {
  DRAFT
  SENT
  DELIVERED
  VIEWED
  SIGNED
  COMPLETED
  DECLINED
  EXPIRED
  VOIDED
}

model Recipient {
  id              String   @id @default(cuid())
  documentId      String
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  name            String
  email           String
  phone           String?
  role            RecipientRole @default(SIGNER)
  order           Int      @default(1)
  authCode        String?  // SMS OTP / access code
  status          RecipientStatus @default(PENDING)
  viewedAt        DateTime?
  signedAt        DateTime?
  declinedAt      DateTime?
  declinedReason  String?
  ipAddress       String?
  userAgent       String?
  geolocation     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  signatures      Signature[]
  events          DocumentEvent[]
}

enum RecipientRole {
  SIGNER
  CC
  APPROVER
  VIEWER
  EDITOR
}

enum RecipientStatus {
  PENDING
  SENT
  DELIVERED
  VIEWED
  SIGNED
  DECLINED
  BOUNCED
}

model Signature {
  id              String   @id @default(cuid())
  documentId      String
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  recipientId     String
  recipient       Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  type            SignatureType
  pageNumber      Int
  xPosition       Float    // 0-100 percentage
  yPosition       Float    // 0-100 percentage
  width           Float    @default(20)
  height          Float    @default(6)
  value           String?  // signature image base64 / typed text
  fontFamily      String?
  signedAt        DateTime?
  ipAddress       String?
  createdAt       DateTime @default(now())
}

enum SignatureType {
  SIGNATURE
  INITIALS
  DATE
  TEXT
  CHECKBOX
  RADIO
  DROPDOWN
  STAMP
  COMPANY_SEAL
}

// ============================================================
// TRACKING & EVENTS (Brevo webhook consumers)
// ============================================================

model DocumentEvent {
  id              String   @id @default(cuid())
  documentId      String
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  recipientId     String?
  recipient       Recipient? @relation(fields: [recipientId], references: [id])
  eventType       DocumentEventType
  // Brevo webhook payload fields
  brevoMessageId  String?
  brevoEvent      String?  // delivered, opened, clicked, bounced, blocked
  payload         String?  // full JSON
  ipAddress       String?
  userAgent       String?
  geolocation     String?
  createdAt       DateTime @default(now())
}

enum DocumentEventType {
  EMAIL_QUEUED
  EMAIL_SENT
  EMAIL_DELIVERED
  EMAIL_BOUNCED
  EMAIL_OPENED
  EMAIL_CLICKED
  DOC_VIEWED
  PAGE_VIEWED
  FIELD_FILLED
  SIGNED
  DECLINED
  COMPLETED
  VOIDED
  REMINDER_SENT
}

model AuditEntry {
  id              String   @id @default(cuid())
  documentId      String
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  actorUserId     String?
  actor           User?    @relation(fields: [actorUserId], references: [id])
  action          String
  details         String?  // JSON
  prevHash        String?
  hash            String   // SHA-256 hash chain — tamper-evident
  ipAddress       String?
  createdAt       DateTime @default(now())
}

model AuditLog {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  actorUserId     String?
  actor           User?    @relation(fields: [actorUserId], references: [id])
  action          String
  resourceType    String?
  resourceId      String?
  details         String?
  ipAddress       String?
  createdAt       DateTime @default(now())
}

// ============================================================
// INTEGRATIONS & API
// ============================================================

model Integration {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  provider        IntegrationProvider
  credentials     String   // encrypted JSON
  enabled         Boolean  @default(true)
  lastSyncAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum IntegrationProvider {
  BREVO
  SALESFORCE
  HUBSPOT
  PIPEDRIVE
  SLACK
  TEAMS
  GOOGLE_DRIVE
  ONEDRIVE
  DROPBOX
  STRIPE
  ZAPIER
}

model ApiKey {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  name            String
  keyHash         String   // hashed API key
  keyPrefix       String   // first 8 chars for display
  scopes          String   // JSON array of scopes
  rateLimitPerMin Int      @default(60)
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime @default(now())
}

model Notification {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String
  title           String
  body            String?
  link            String?
  readAt          DateTime?
  createdAt       DateTime @default(now())
}
